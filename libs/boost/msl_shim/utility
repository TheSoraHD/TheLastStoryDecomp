#ifndef SHIM_UTILITY
#define SHIM_UTILITY
// Stand-in for MSL C++ <utility> (only what Boost needs). __MSL_CPP__ is set below 0x8000 so that
// Boost does not include <msl_utility>; the real MSL version is unknown.
#define __MSL_CPP__ 0x7000
namespace std {
template <class T1, class T2> struct pair { T1 first; T2 second; pair() {} pair(const T1& a, const T2& b) : first(a), second(b) {} };

}
#endif
